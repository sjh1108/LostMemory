{
  "annotations": {
    "list": []
  },
  "description": "LostMemory player analytics — ingest / queue / flush + game signals (DAU, death hotspot, session length)",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "PROMETHEUS_DATASOURCE_UID" },
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (event_type) (rate(analytics_events_ingested_total[1m]))",
          "legendFormat": "{{event_type}}",
          "refId": "A"
        }
      ],
      "title": "Ingest rate by event_type",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "PROMETHEUS_DATASOURCE_UID" },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "analytics_queue_length",
          "legendFormat": "main queue",
          "refId": "A"
        },
        {
          "expr": "analytics_dlq_length",
          "legendFormat": "dead-letter",
          "refId": "B"
        }
      ],
      "title": "Redis queue length",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "PROMETHEUS_DATASOURCE_UID" },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(analytics_ingest_duration_seconds_bucket[5m])))",
          "legendFormat": "ingest p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(analytics_flush_duration_seconds_bucket[5m])))",
          "legendFormat": "flush p95",
          "refId": "B"
        }
      ],
      "title": "Ingest / Flush latency p95",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "PROMETHEUS_DATASOURCE_UID" },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (le) (rate(analytics_event_lag_seconds_bucket[5m]))",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ],
      "title": "Event lag distribution (received_time - event_time)",
      "type": "heatmap"
    },
    {
      "datasource": { "type": "postgres", "uid": "POSTGRES_DATASOURCE_UID" },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 5,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "format": "time_series",
          "rawSql": "SELECT DATE(event_time) AS time, COUNT(DISTINCT user_id) AS dau\nFROM player_events\nWHERE event_type = 'session_start'\n  AND event_time > now() - interval '30 days'\nGROUP BY 1\nORDER BY 1;",
          "refId": "A"
        }
      ],
      "title": "DAU (last 30 days)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "postgres", "uid": "POSTGRES_DATASOURCE_UID" },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 6,
      "options": { "showHeader": true },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT stage_id, payload->>'cause_enemy_id' AS enemy, COUNT(*) AS deaths\nFROM player_events\nWHERE event_type = 'player_died'\n  AND event_time > now() - interval '7 days'\nGROUP BY 1, 2\nORDER BY 3 DESC\nLIMIT 20;",
          "refId": "A"
        }
      ],
      "title": "Death hotspot (last 7 days, top 20)",
      "type": "table"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["lostmemory", "analytics"],
  "templating": { "list": [] },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "LostMemory — Player Analytics",
  "uid": "lm-player-analytics",
  "version": 1,
  "weekStart": ""
}

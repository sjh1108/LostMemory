// Spring Boot 빌드/배포 파이프라인
// 트리거: 수동 (Build with Parameters) 또는 GitLab CI 가 buildWithParameters 호출
// 전제:
//  - Jenkins 는 EC2 같은 호스트에서 실행되며 /var/run/docker.sock 을 마운트(DooD)
//  - "lostmemory-env" credential 이 Secret file 타입으로 등록되어 있어 전체 .env 를 제공
//  - Job 은 "Pipeline from SCM" 으로 이 파일(Script Path: server/Jenkinsfile)을 가리킨다
//  - GitLab CI 에서 호출 시 "Trigger builds remotely" 토큰으로 인증

pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }

  parameters {
    booleanParam(
      name: 'SKIP_TESTS',
      defaultValue: true,
      description: 'Gradle test 단계 스킵 (Dockerfile 내부는 이미 -x test)')
    string(
      name: 'COMMIT_SHA',
      defaultValue: '',
      description: 'GitLab CI 가 전달한 트리거 커밋 SHA (추적/로그용, 비어있으면 develop HEAD)')
    string(
      name: 'BRANCH',
      defaultValue: 'develop',
      description: 'GitLab CI 가 전달한 브랜치명 (추적/로그용)')
  }

  environment {
    // Secret file 타입 credential — Jenkins 가 임시 파일로 풀어 경로를 ENV_FILE 에 주입
    ENV_FILE = credentials('lostmemory-env')
    // 서버 빌드에는 Unity 클라이언트용 LFS 바이너리(png/mp3/psd 등)가 전혀 필요 없음.
    // smudge 필터가 checkout 마다 LFS 서버로 다운로드하러 가서 10분 timeout 으로 죽었음.
    GIT_LFS_SKIP_SMUDGE = '1'
  }

  stages {
    stage('Checkout') {
      steps {
        echo "Trigger context — branch: ${params.BRANCH}, commit: ${params.COMMIT_SHA ?: '(미전달)'}"
        checkout scm
      }
    }

    stage('Build & Test') {
      when { expression { return !params.SKIP_TESTS } }
      steps {
        dir('server') {
          sh 'chmod +x gradlew'
          sh './gradlew clean test --no-daemon'
        }
      }
      post {
        always {
          junit allowEmptyResults: true, testResults: 'server/build/test-results/test/*.xml'
        }
      }
    }

    stage('Docker Build') {
      steps {
        dir('server') {
          // image 빌드만 — 태깅(server-app:N) + up -d + healthy 폴링은 deploy.sh 가 담당
          sh 'docker compose --env-file "$ENV_FILE" build app'
        }
      }
    }

    stage('Deploy') {
      // server/scripts/deploy.sh 가 태깅 / up -d / healthy 폴링 / 실패 로그 출력 까지 일임.
      // 운영자가 EC2 SSH 에서 수동 배포/롤백 시에도 같은 스크립트를 호출 — 단일 진입점.
      steps {
        dir('server') {
          sh 'chmod +x scripts/deploy.sh'
          sh './scripts/deploy.sh deploy "$BUILD_NUMBER"'
        }
      }
    }

    stage('Smoke Test') {
      // healthy 검증은 Deploy stage 의 deploy.sh 가 끝낸 상태.
      // 가시성용으로 현재 image / state 만 출력.
      steps {
        dir('server') {
          sh './scripts/deploy.sh status'
        }
      }
    }
  }

  post {
    failure {
      dir('server') {
        sh 'docker compose --env-file "$ENV_FILE" logs --tail=200 app || true'
      }
      echo "❌ Build #${BUILD_NUMBER} failed. 위 로그 확인 후 수동 롤백 필요."
      script {
        notifyMattermost('FAILURE')
      }
    }
    success {
      echo "✅ Build #${BUILD_NUMBER} deployed. Image: server-app:${BUILD_NUMBER}, branch: ${params.BRANCH}, commit: ${params.COMMIT_SHA ?: '(미전달)'}"
      script {
        notifyMattermost('SUCCESS')
      }
    }
  }
}

// ENV_FILE(.env Secret file) 의 MATTERMOST_WEBHOOK_URL 라인을 grep 으로 추출해
// Mattermost incoming webhook 으로 빌드 결과 알림을 보낸다.
//
// .env 에 라인이 없으면 silent skip — 운영 .env 갱신 전이라도 빌드 자체는 정상.
// webhook 호출 실패해도 빌드 자체는 fail 시키지 않는다 ('|| echo' 처리).
//
// 운영자가 .env 에 한 줄 추가:
//   MATTERMOST_WEBHOOK_URL=https://meeting.ssafy.com/hooks/<token>
def notifyMattermost(String status) {
  def emoji = status == 'SUCCESS' ? '✅' : '❌'
  def text = """${emoji} **Jenkins 빌드 #${env.BUILD_NUMBER} ${status}** — `${env.JOB_NAME}`
- 브랜치: `${params.BRANCH ?: '(미전달)'}`
- 커밋: `${params.COMMIT_SHA ?: '(미전달)'}`
- 이미지: `server-app:${env.BUILD_NUMBER}`
- 콘솔: ${env.BUILD_URL}console"""

  def payload = groovy.json.JsonOutput.toJson([text: text])
  // sh 의 single-quoted 문자열 안에 single quote 가 포함될 때 깨지지 않게 escape
  def shellSafePayload = payload.replace("'", "'\\''")

  sh """
    set +x
    MM_URL=\$(grep '^MATTERMOST_WEBHOOK_URL=' "\$ENV_FILE" | head -1 | cut -d= -f2-)
    if [ -z "\$MM_URL" ]; then
      echo "[notify] MATTERMOST_WEBHOOK_URL 미설정 — 알림 건너뜀"
      exit 0
    fi
    curl -fsS -X POST -H 'Content-Type: application/json' \\
      -d '${shellSafePayload}' \\
      "\$MM_URL" >/dev/null \\
      || echo "[notify] webhook 호출 실패 — 빌드 자체는 영향 없음"
  """
}

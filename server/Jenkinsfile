// Spring Boot 빌드/배포 파이프라인 (수동 트리거)
// 전제:
//  - Jenkins 는 EC2 같은 호스트에서 실행되며 /var/run/docker.sock 을 마운트(DooD)
//  - "lostmemory-env" credential 이 Secret file 타입으로 등록되어 있어 전체 .env 를 제공
//  - Job 은 "Pipeline from SCM" 으로 이 파일(Script Path: server/Jenkinsfile)을 가리킨다

pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }

  parameters {
    booleanParam(
      name: 'SKIP_TESTS',
      defaultValue: true,
      description: 'Gradle test 단계 스킵 (Dockerfile 내부는 이미 -x test)')
  }

  environment {
    // Secret file 타입 credential — Jenkins 가 임시 파일로 풀어 경로를 ENV_FILE 에 주입
    ENV_FILE = credentials('lostmemory-env')
    // 서버 빌드에는 Unity 클라이언트용 LFS 바이너리(png/mp3/psd 등)가 전혀 필요 없음.
    // smudge 필터가 checkout 마다 LFS 서버로 다운로드하러 가서 10분 timeout 으로 죽었음.
    GIT_LFS_SKIP_SMUDGE = '1'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Build & Test') {
      when { expression { return !params.SKIP_TESTS } }
      steps {
        dir('server') {
          sh 'chmod +x gradlew'
          sh './gradlew clean test --no-daemon'
        }
      }
      post {
        always {
          junit allowEmptyResults: true, testResults: 'server/build/test-results/test/*.xml'
        }
      }
    }

    stage('Docker Build') {
      steps {
        dir('server') {
          sh 'docker compose --env-file "$ENV_FILE" build app'
          // 태깅 — 실패해도 배포는 계속 (향후 롤백용 보존 태그)
          sh 'docker tag server-app:latest server-app:${BUILD_NUMBER} || true'
        }
      }
    }

    stage('Deploy') {
      steps {
        dir('server') {
          sh 'docker compose --env-file "$ENV_FILE" up -d app'
          sh 'docker compose --env-file "$ENV_FILE" ps'
        }
      }
    }

    stage('Smoke Test') {
      // Jenkins 컨테이너 내부에서 localhost 가 EC2 호스트가 아니라 Jenkins 자신이므로
      // 포트로 접근 대신 compose healthcheck 상태를 폴링하는 방식으로 검증
      steps {
        dir('server') {
          sh '''
            set +e
            for i in $(seq 1 30); do
              if docker compose --env-file "$ENV_FILE" ps app | grep -q "(healthy)"; then
                echo "✅ app is healthy"
                exit 0
              fi
              echo "Waiting for app healthy... ($i/30)"
              sleep 3
            done
            echo "❌ app did not reach healthy state"
            docker compose --env-file "$ENV_FILE" ps
            docker compose --env-file "$ENV_FILE" logs --tail=100 app
            exit 1
          '''
        }
      }
    }
  }

  post {
    failure {
      dir('server') {
        sh 'docker compose --env-file "$ENV_FILE" logs --tail=200 app || true'
      }
      echo "❌ Build #${BUILD_NUMBER} failed. 위 로그 확인 후 수동 롤백 필요."
    }
    success {
      echo "✅ Build #${BUILD_NUMBER} deployed. Image: server-app:${BUILD_NUMBER}"
    }
  }
}

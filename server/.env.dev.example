# ===========================================
# 환경
# ===========================================
SPRING_PROFILES_ACTIVE=prod
TZ=Asia/Seoul

# ===========================================
# PostgreSQL
# ===========================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=          # 운영용 강력한 비밀번호 (별도 공유)

# ===========================================
# Redis
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=             # 운영용 비밀번호 (별도 공유)

# ===========================================
# Spring Boot
# ===========================================
SERVER_PORT=18080
RELAY_PORT=
JWT_SECRET=                 # 운영용 시크릿 (별도 공유, 최소 256bit)
JWT_EXPIRATION=
JWT_ACCESS_EXPIRATION=      # access token 만료 (초)
JWT_REFRESH_EXPIRATION=     # refresh token 만료 (초)
JWT_SESSION_EXPIRATION=     # session token 만료 (초)
HANDSHAKE_TIMEOUT_MS=       # UDP 통신 핸드셰이크 타임아웃 (밀리초)

# ===========================================
# CORS
# ===========================================
CORS_ALLOWED_ORIGIN_PATTERNS=    # Cross-Origin Resource Sharing 정책

# ===========================================
# Nginx / Domain
# ===========================================
DOMAIN=your-prod-domain.com
HTTP_PORT=80
HTTPS_PORT=443

# ===========================================
# Relay (자체 Netty UDP 7777)
# ===========================================
# 백엔드는 envvar 기본값 fallback 미사용 정책 — 모든 키를 명시 채우지 않으면 binding fail.
RELAY_PORT=7777
HANDSHAKE_TIMEOUT_MS=5000
RELAY_PEER_IDLE_TIMEOUT_MS=10000   # peer 가 이 시간 이상 패킷 미수신 시 dead 처리 (BYE 누락 fallback)
RELAY_CLEANUP_INTERVAL_MS=2000     # idle peer cleanup 주기 — peer-idle-timeout-ms 보다 짧게

# ===========================================
# CORS (Spring 백엔드)
# ===========================================
# dev 는 "*" 허용 (Unity Editor / 로컬 webgl 테스트). prod 는 도메인 화이트리스트로 변경.
CORS_ALLOWED_ORIGIN_PATTERNS=*

# ===========================================
# ComfyUI 연동 (필요 시)
# ===========================================
COMFYUI_HOST=
COMFYUI_PORT=
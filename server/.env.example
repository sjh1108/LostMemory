# ===========================================
# 환경
# ===========================================
SPRING_PROFILES_ACTIVE=prod
TZ=Asia/Seoul

# ===========================================
# PostgreSQL
# ===========================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=          # 운영용 강력한 비밀번호 (별도 공유)

# ===========================================
# Redis
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=             # 운영용 비밀번호 (별도 공유)

# ===========================================
# Spring Boot
# ===========================================
SERVER_PORT=8080
RELAY_PORT=
JWT_SECRET=                 # 운영용 시크릿 (별도 공유, 최소 256bit)
JWT_EXPIRATION=
JWT_ACCESS_EXPIRATION=      # access token 만료 (초)
JWT_REFRESH_EXPIRATION=     # refresh token 만료 (초)
JWT_SESSION_EXPIRATION=     # session token 만료 (초)
HANDSHAKE_TIMEOUT_MS=       # UDP 통신 핸드셰이크 타임아웃 (밀리초)

# ===========================================
# CORS
# ===========================================
CORS_ALLOWED_ORIGIN_PATTERNS=    # Cross-Origin Resource Sharing 정책

# ===========================================
# Nginx / Domain
# ===========================================
DOMAIN=your-prod-domain.com
HTTP_PORT=80
HTTPS_PORT=443
LETSENCRYPT_EMAIL=          # Let's Encrypt 만료 알림 수신 메일 (운영자 메일)

# ===========================================
# Mattermost (Jenkins 빌드 알림 + Alertmanager 임계 알림 공용)
# ===========================================
# 한 webhook 을 Jenkins 빌드 결과 + Prometheus Alertmanager 가 함께 사용한다.
# 채널 분리 원한다면 별도 webhook 발급 후 alertmanager.yml 의 api_url_file 만 분리.
MATTERMOST_WEBHOOK_URL=     # incoming webhook URL (https://meeting.ssafy.com/hooks/...)

# ===========================================
# Grafana (모니터링 대시보드 — docker-compose.monitoring.yml)
# ===========================================
# Grafana admin 계정 비밀번호. 운영자 SSH 로 모니터링 스택 첫 기동 전 필수 채움.
# Jenkins credential `lostmemory-env` (Secret file) 도 동일하게 갱신.
GRAFANA_ADMIN_PASSWORD=     # 운영용 강력한 비밀번호 (별도 공유)

# ===========================================
# Relay (자체 Netty UDP 7777)
# ===========================================
# 백엔드는 envvar 기본값 fallback 미사용 정책 — 모든 키를 명시 채우지 않으면 binding fail.
RELAY_PORT=7777
HANDSHAKE_TIMEOUT_MS=5000
RELAY_PEER_IDLE_TIMEOUT_MS=10000   # peer 가 이 시간 이상 패킷 미수신 시 dead 처리 (BYE 누락 fallback)
RELAY_CLEANUP_INTERVAL_MS=2000     # idle peer cleanup 주기 — peer-idle-timeout-ms 보다 짧게

# ===========================================
# CORS (Spring 백엔드)
# ===========================================
# 콤마 구분 패턴. dev 는 "*", prod 는 도메인 화이트리스트
CORS_ALLOWED_ORIGIN_PATTERNS=https://k14c201.p.ssafy.io

# ===========================================
# ComfyUI 연동 (필요 시)
# ===========================================
COMFYUI_HOST=
COMFYUI_PORT=
# ===========================================
# 환경
# ===========================================
SPRING_PROFILES_ACTIVE=prod
TZ=Asia/Seoul

# ===========================================
# PostgreSQL
# ===========================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=          # 운영용 강력한 비밀번호 (별도 공유)

# ===========================================
# Redis
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=             # 운영용 비밀번호 (별도 공유)

# ===========================================
# Spring Boot
# ===========================================
SERVER_PORT=8080
JWT_SECRET=                 # 운영용 시크릿 (별도 공유, 최소 256bit)
JWT_ACCESS_EXPIRATION=      # access token 만료 (초)
JWT_REFRESH_EXPIRATION=     # refresh token 만료 (초)

# ===========================================
# Nginx / Domain
# ===========================================
DOMAIN=your-prod-domain.com
HTTP_PORT=80
HTTPS_PORT=443
LETSENCRYPT_EMAIL=          # Let's Encrypt 만료 알림 수신 메일 (운영자 메일)

# ===========================================
# ComfyUI 연동 (필요 시)
# ===========================================
COMFYUI_HOST=
COMFYUI_PORT=
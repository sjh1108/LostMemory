# ===========================================
# 환경
# ===========================================
SPRING_PROFILES_ACTIVE=prod
TZ=Asia/Seoul

# ===========================================
# PostgreSQL
# ===========================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=          # 운영용 강력한 비밀번호 (별도 공유)

# ===========================================
# Redis
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=             # 운영용 비밀번호 (별도 공유)

# ===========================================
# Spring Boot
# ===========================================
SERVER_PORT=8080
JWT_SECRET=                 # 운영용 시크릿 (별도 공유, 최소 256bit)
JWT_ACCESS_EXPIRATION=      # access token 만료 (초)
JWT_REFRESH_EXPIRATION=     # refresh token 만료 (초)
JWT_SESSION_EXPIRATION=600  # session token 만료 (초) — JwtProperties 4번째 필드, 누락 시 binding fail

# ===========================================
# Nginx / Domain
# ===========================================
DOMAIN=your-prod-domain.com
HTTP_PORT=80
HTTPS_PORT=443
LETSENCRYPT_EMAIL=          # Let's Encrypt 만료 알림 수신 메일 (운영자 메일)

# ===========================================
# Mattermost (Jenkins 빌드 알림용)
# ===========================================
MATTERMOST_WEBHOOK_URL=     # Jenkins 알림 전용 incoming webhook URL (https://meeting.ssafy.com/hooks/...)

# ===========================================
# Relay (자체 Netty UDP 7777)
# ===========================================
RELAY_PORT=7777
HANDSHAKE_TIMEOUT_MS=5000

# ===========================================
# ComfyUI 연동 (필요 시)
# ===========================================
COMFYUI_HOST=
COMFYUI_PORT=
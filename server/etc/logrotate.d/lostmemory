# LostMemory 운영 로그 rotation 정책.
# 운영자가 이 파일을 호스트의 /etc/logrotate.d/lostmemory 로 복사해서 적용.
# Ubuntu 기본 logrotate 데몬이 매일 한 번 실행하면서 이 정책을 적용한다.
#
# 적용 대상:
#  - /var/log/certbot-renew.log : root crontab 의 certbot-renew.sh wrapper 출력
#
# 그 외 호스트 로그(/var/log/syslog, /var/log/kern.log, /var/log/journal/* 등)는
# Ubuntu 기본 logrotate / journald 가 이미 처리한다 — 추가 정책 불필요.

/var/log/certbot-renew.log {
    weekly
    rotate 8
    compress
    delaycompress
    missingok
    notifempty
    create 0640 root root
}

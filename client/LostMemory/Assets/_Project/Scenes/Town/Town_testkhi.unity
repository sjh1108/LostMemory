  m_Script: {fileID: 11500000, guid: 8b2e9d4f5a6c7b5892345678901bcdef, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LostMemory.Town.TownTutorialController
  _pages:
  - Title: "\uAE30\uC5B5\uC758 \uC9D1"
    Body: "\uB358\uC804\uC5D0\uC11C \uBAA8\uC740 \uD30C\uD3B8 \uC73C\uB85C \uAE30\uC5B5
      \uC870\uAC01 \uC744 \uD574\uAE08\uD569\uB2C8\uB2E4. \uBCF4\uB77C\uC0C9 \uC9D1
      \uC55E NPC\uC5D0\uAC8C \uB2E4\uAC00\uAC00 F\uB97C \uB204\uB974\uC138\uC694."
    WorldMarkerPosition: {x: 0, y: 13, z: 0}
  - Title: "\uC7AC\uB2A5 NPC"
    Body: "\uD3EC\uC778\uD2B8\uB85C 5\uC885 \uC7AC\uB2A5(\uCE58\uBA85/\uACF5\uC18D/\uBC29\uC5B4/\uC774\uB3D9/\uCCB4\uB825)\uC744
      \uAC15\uD654\uD569\uB2C8\uB2E4. \uBC18\uB4DC\uC2DC Save \uBC84\uD2BC\uC744
      \uB20C\uB7EC\uC57C \uC800\uC7A5\uB3FC\uC694. F\uB85C \uB300\uD654."
    WorldMarkerPosition: {x: 22.59, y: -6, z: 0}
  - Title: "\uB358\uC804 \uC785\uAD6C"
    Body: "\uB358\uC804 \uD3EC\uD0C8\uC5D0 \uAC00\uAE4C\uC774 \uAC00\uC11C E. \uC989\uC2DC
      \uC785\uC7A5\uD558\uBBC0\uB85C \uC900\uBE44\uB97C \uB9C8\uCE5C \uB4A4 \uB4E4\uC5B4\uAC00\uC138\uC694."
    WorldMarkerPosition: {x: 21.21, y: 12, z: 0}
  _panel: {fileID: 1155774240}
  _worldMarkerPrefab: {fileID: 1100000000000000010, guid: ad4f1b6c7e8d9f0a1234567890bcdef1,
    type: 3}

.be-root {
    flex-grow: 1;
    flex-direction: column;
    background-color: rgb(56, 56, 56);
}

.be-toolbar {
    flex-shrink: 0;
}

.be-title {
    flex-shrink: 0;
    color: rgb(220, 220, 220);
    font-size: 13px;
    -unity-font-style: bold;
    margin-left: 4px;
    margin-right: 12px;
    -unity-text-align: middle-left;
}

.be-search {
    flex-shrink: 0;
    flex-grow: 0;
    width: 240px;
    margin-right: 8px;
}

.be-toolbar-spacer {
    flex-grow: 1;
    flex-shrink: 1;
}

.be-refresh-btn {
    flex-shrink: 0;
    flex-grow: 0;
    width: 80px;
}

.be-save-btn {
    flex-shrink: 0;
    flex-grow: 0;
    width: 80px;
    margin-left: 4px;
}

.be-body {
    flex-grow: 1;
    flex-direction: row;
}

.be-left-panel {
    min-width: 180px;
    background-color: rgb(48, 48, 48);
    border-right-width: 1px;
    border-right-color: rgb(20, 20, 20);
    padding: 4px;
}

.be-right-panel {
    flex-grow: 1;
    background-color: rgb(56, 56, 56);
    padding: 8px;
}

.be-statusbar {
    height: 22px;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding-left: 8px;
    background-color: rgb(40, 40, 40);
    border-top-width: 1px;
    border-top-color: rgb(20, 20, 20);
}

.be-status-text {
    color: rgb(180, 180, 180);
    font-size: 11px;
}

.be-placeholder {
    color: rgb(150, 150, 150);
    -unity-font-style: italic;
}

.be-detail-empty {
    color: rgb(150, 150, 150);
    -unity-font-style: italic;
    margin-top: 16px;
}

.be-tree-item-dirty {
    color: rgb(255, 130, 130);
    -unity-font-style: bold;
}

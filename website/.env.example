# LostMemory 게임 공식 사이트 (Spring Boot CMS) — 운영 환경변수 template.
# 운영자가 EC2#2 SSH 에서 `cp .env.example .env` 후 운영 비밀번호로 값 변경.
# .env 는 git 에 커밋 X (.gitignore 차단됨).

# ===========================================
# Timezone
# ===========================================
TZ=Asia/Seoul

# ===========================================
# PostgreSQL (cms-postgres 컨테이너 + JPA datasource)
# ===========================================
POSTGRES_DB=lostmemory_cms
POSTGRES_USER=cms
POSTGRES_PASSWORD=change-me-strong-pw

# ===========================================
# Spring Boot
# ===========================================
SERVER_PORT=8081

# ===========================================
# Admin 계정 seed (첫 부팅 시 AdminSeedRunner 가 BCrypt hash + insert)
# ===========================================
# 첫 부팅 후 이 계정으로 admin 진입 가능 (URL 은 아래 ADMIN_BASE_PATH 의 /login 서브 path).
# 변경 시 application 재시작 X — DB 의 admin_user.password_hash 직접 update 또는
# 추후 admin UI 의 비밀번호 변경 기능 사용.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-pw

# ===========================================
# Admin URL base path — surface 축소용 obscure path
# ===========================================
# 운영 .env 에서 추측 어려운 값으로 반드시 변경 (예: /manage-XXXX, /control-YYYY).
# 본 example 의 placeholder 그대로 두면 application 부팅 가능하지만 admin URL 이
# 노출되니 운영 X. .env 자체는 git 미커밋 (gitignore) 이라 안전.
ADMIN_BASE_PATH=/CHANGE-ME-OBSCURE-PATH

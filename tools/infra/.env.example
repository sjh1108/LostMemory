# ===========================================
# AI tool infra
# ===========================================
TZ=Asia/Seoul

# ===========================================
# Domain
# ===========================================
# Replace these after buying the real domain.
PUBLIC_DOMAIN=example.com
COMFYUI_DOMAIN=comfy.example.com
LETSENCRYPT_EMAIL=admin@example.com

# ===========================================
# Basic Auth
# ===========================================
BASIC_AUTH_REALM=LostMemory AI Tool

# ===========================================
# Ports
# ===========================================
HTTP_PORT=80
HTTPS_PORT=443

# ===========================================
# Upstreams
# ===========================================
# AI backend is not implemented in AI-203 yet.
# EC2 default after backend implementation: http://ai-backend:8080
# Local smoke-test default: http://host.docker.internal:8080
AI_BACKEND_UPSTREAM=http://host.docker.internal:8080

# EC2 cannot reach a home/office desktop unless networking is opened.
# Replace this with a reachable ComfyUI address:
# - VPN/mesh IP: http://<desktop-vpn-ip>:8188
# - Port-forwarded public endpoint: http://<public-ip-or-domain>:8188
# - SSH reverse tunnel endpoint on EC2: http://127.0.0.1:<forwarded-port>
# Local smoke-test default: http://host.docker.internal:8188
COMFYUI_UPSTREAM=http://host.docker.internal:8188

# ===========================================
# PostgreSQL
# ===========================================
POSTGRES_DB=ai_tool
POSTGRES_USER=ai_tool
POSTGRES_PASSWORD=change-me
POSTGRES_DEV_PORT=55432

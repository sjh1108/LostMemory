server {
    listen      80 default_server;
    listen      [::]:80 default_server;
    server_name ${PUBLIC_DOMAIN};

    resolver 127.0.0.11 valid=10s ipv6=off;

    proxy_connect_timeout  10s;
    proxy_send_timeout     60s;
    proxy_read_timeout     60s;

    location = / {
        default_type text/plain;
        return 200 "LostMemory AI tool reverse proxy is up.\n";
    }

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /api/ {
        set $ai_backend_upstream ${AI_BACKEND_UPSTREAM};
        proxy_pass $ai_backend_upstream$request_uri;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;

        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
    }
}

server {
    listen      80;
    listen      [::]:80;
    server_name ${COMFYUI_DOMAIN};

    resolver 127.0.0.11 valid=10s ipv6=off;

    client_max_body_size 100m;
    proxy_connect_timeout  10s;
    proxy_send_timeout     3600s;
    proxy_read_timeout     3600s;

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        set $comfyui_upstream ${COMFYUI_UPSTREAM};
        proxy_pass $comfyui_upstream$request_uri;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;

        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;

        proxy_buffering off;
        proxy_request_buffering off;
    }
}

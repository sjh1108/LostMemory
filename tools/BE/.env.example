# ComfyUI
# Default: ComfyUI runs on the operating desktop host.
# Alternative: replace with http://<GPU_DESKTOP_IP>:8188 when ComfyUI runs on a GPU desktop.
COMFYUI_BASE_URL=http://host.docker.internal:8188
COMFYUI_OUTPUT_DIR=C:/Users/SSAFY/Desktop/2학기 3PJT/S14P31C201/tools/ComfyUI/output
COMFYUI_MODELS_DIR=C:/Users/SSAFY/Desktop/2학기 3PJT/S14P31C201/tools/ComfyUI/models
COMFYUI_LORAS_DIR=C:/Users/SSAFY/Desktop/2학기 3PJT/S14P31C201/tools/ComfyUI/models/loras

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_tool
POSTGRES_USER=ai_tool
POSTGRES_PASSWORD=change-me

# AWS S3
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=replace-me
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
S3_SIGNED_URL_TTL_SECONDS=86400

# Generation polling
COMFYUI_HISTORY_POLL_INTERVAL_MS=1000
COMFYUI_HISTORY_POLL_TIMEOUT_SECONDS=300
